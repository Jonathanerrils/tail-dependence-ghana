  "pseudo_obs_source": "def pseudo_obs(x: pd.DataFrame | np.ndarray) -> np.ndarray:\n    \"\"\"Rank-based pseudo-observations u_i = rank_i / (n + 1).\"\"\"\n    a = np.asarray(x, dtype=float)\n    n = a.shape[0]\n    ranks = np.apply_along_axis(stats.rankdata, 0, a)\n    return ranks / (n + 1.0)\n"
