__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Yahoo Finance ToS: fetch-only, do not redistribute raw/derived Yahoo data
data/raw/*
data/processed/*_real.csv
data/processed/prices_yahoo_raw.csv

# BoG official data: OK to commit with attribution (see README) —
# explicitly un-ignore the directory and its contents
!data/raw/.gitkeep
!data/raw/bog/
!data/raw/bog/**

# LaTeX build artifacts
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.log
paper/latex/*.out
paper/latex/*.spl

# Local development caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Nested LaTeX build artifacts
paper/latex/**/*.aux
paper/latex/**/*.bbl
paper/latex/**/*.blg
paper/latex/**/*.log
paper/latex/**/*.out
paper/latex/**/*.fls
paper/latex/**/*.fdb_latexmk
paper/latex/**/*.synctex.gz
